# SchediQ frontend configuration. Copy to .env.local for local development.
# On Vercel, set it under Project > Settings > Environment Variables instead.

# Base URL of the SchediQ API (no trailing slash).
# Local: http://localhost:4000
# Production: your Render service URL, e.g. https://schediq-api.onrender.com
# NEXT_PUBLIC_ variables are inlined into the browser bundle at BUILD time, so
# redeploy the frontend after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000
