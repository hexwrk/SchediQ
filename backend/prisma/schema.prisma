generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  // Authorization role. Checked server-side on every admin request (loaded from
  // the DB, never trusted from the JWT) so a demotion takes effect immediately.
  role         Role        @default(USER)
  // Demo subscription tier. No billing: flipped via PATCH /api/account/tier.
  accountType  AccountType @default(FREE)

  subjects     Subject[]
  tasks        Task[]
  preferences  Preference?
  aiParses     AiParseLog[]
  courses      Course[]
}

enum Role {
  USER
  SUPER_ADMIN
}

enum AccountType {
  FREE
  PREMIUM
}

// One row per AI parse request. The FREE tier is capped per calendar day, so the
// gate counts today's rows for the user rather than storing a mutable counter.
model AiParseLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Audit trail for admin backup/restore actions; the System page shows the
// latest BACKUP timestamp from here. actorEmail is denormalised on purpose so
// the entry survives the actor's account being deleted.
model BackupLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  kind       String   // "BACKUP" | "RESTORE"
  format     String   // "sql" | "json"
  filename   String
  sizeBytes  Int
  actorEmail String
}

// cognitive_category drives the clustering penalty in the scheduler (Sprint 3).
// color_tag is display-only, never read by scheduling logic.
model Subject {
  id                String   @id @default(uuid())
  name              String
  cognitiveCategory String
  colorTag          String   @default("#6366f1")
  createdAt         DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks    Task[]
  courses  Course[]

  @@unique([userId, name])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  SCHEDULED
  DONE
}

model Task {
  id          String       @id @default(uuid())
  title       String
  deadline    DateTime
  durationMin Int
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  // Set when the task was created by "Add this course to my schedule": one task
  // per lesson. This is the link between the course generator and the planner.
  lessonId  String?  @unique
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  sessions  StudySession[]
}

// Derived by the scheduling engine (Sprint 3); the calendar view renders from these, not from Tasks directly.
model StudySession {
  id        String   @id @default(uuid())
  startsAt  DateTime
  endsAt    DateTime
  // Completion lives on the session (Sprint 3 gamification). Null = not done.
  // XP/streak derive from these timestamps; task.status is kept roughly in sync.
  completedAt DateTime?
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Preference {
  id               String @id @default(uuid())
  maxDailyMins     Int    @default(180)
  preferredStart   String @default("09:00")
  preferredEnd     String @default("21:00")
  breakMins        Int    @default(10)
  clustering       Boolean @default(true)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CourseSource {
  AI   // generated by OpenAI Structured Outputs
  SEED // built offline from the bundled topic templates (no network)
}

// AI course generator (DataCamp-style). A course belongs to one user and owns
// an ordered list of lessons. XP for lessons/quizzes/courses is DERIVED from the
// lesson rows below (completedAt, quizScore, quizPassedAt), never stored.
model Course {
  id          String       @id @default(uuid())
  title       String
  topic       String
  level       String       // "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
  description String
  source      CourseSource
  createdAt   DateTime     @default(now())
  // Set once "Add this course to my schedule" has created its tasks, so the
  // button cannot duplicate them.
  scheduledAt DateTime?

  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional roll-up into one of the user's subjects. Lessons and quizzes in a
  // linked course feed that subject's mastery score.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  lessons Lesson[]

  @@index([userId])
}

model Lesson {
  id        String   @id @default(uuid())
  order     Int
  title     String
  content   String   @db.Text
  keyPoints String[]
  // [{ question, options: string[], answerIndex }]. answerIndex is stripped
  // from API responses until the quiz is submitted, so it cannot be read early.
  quiz      Json
  completedAt  DateTime?
  // Best score so far, 0-100.
  quizScore    Int?
  // First time the quiz was passed (>= pass mark); dates the quiz XP event.
  quizPassedAt DateTime?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  task     Task?

  @@unique([courseId, order])
}
