# SchediQ API configuration. Validated at boot (src/lib/env.ts): a missing or
# invalid REQUIRED value stops the server with a list of what to fix.
# Copy to .env for local development. In production set these in the Render
# dashboard instead (never commit real values).

# ---- Required ----

# Runtime database URL. Local: the docker-compose Postgres.
# Neon: the POOLED connection string (host contains "-pooler"), e.g.
#   postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
DATABASE_URL="postgresql://schediq:schediq@localhost:5432/schediq"

# Direct (non-pooled) URL used only by `prisma migrate deploy`. Prisma reads it
# for every migrate command, so set it locally too (same DB as DATABASE_URL).
# Neon: the DIRECT string (no "-pooler" in the host), also ?sslmode=require.
DIRECT_URL="postgresql://schediq:schediq@localhost:5432/schediq"

# JWT signing key, at least 32 characters. Generate: openssl rand -base64 48
# Changing it logs everyone out.
JWT_SECRET="replace-with-output-of-openssl-rand-base64-48"

# Comma-separated browser origins allowed to call the API. "*" is rejected.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
CORS_ORIGIN="http://localhost:3000"

# Port to listen on. Render injects its own PORT; 4000 locally.
PORT=4000

# Task parse / course generator engine: "rule" (offline, no network) or
# "openai" (production default). Any OpenAI failure falls back to the offline
# path, so the app keeps working without the model.
AI_PARSER=rule

# ---- Required when AI_PARSER=openai ----

OPENAI_API_KEY=""

# ---- Optional ----

# development | production | test. Render: production.
NODE_ENV=development

# DEMO_MODE=true is for local testing ONLY: the forgot-password response
# carries the reset link (shown in the UI) and the admin Backup/Restore page is
# enabled. Production MUST be false (the default): the reset link is then only
# written to the server log, and backups are left to Neon.
DEMO_MODE=true

# Per-user AI requests per hour (task parse + course generation). Abuse/cost
# guard only, not a plan limit. Unset = 200.
AI_RATE_LIMIT_PER_HOUR=

# Token lifetime (jsonwebtoken format).
JWT_EXPIRES_IN="7d"

# Frontend origin used to build password reset links. Defaults to the first
# CORS_ORIGIN.
APP_URL="http://localhost:3000"

# In-app backup (DEMO_MODE only). "auto" tries pg_dump then falls back to a
# JSON export; "json" forces the JSON export. Override the binary paths if
# pg_dump / psql are not on PATH (their major version must match the server).
BACKUP_MODE=auto
PG_DUMP_PATH=
PSQL_PATH=

# Off-site backup to S3-compatible object storage (optional): Cloudflare R2,
# Backblaze B2, AWS S3 or MinIO. On only when ALL five are set. Setup:
# docs/CLOUD_BACKUP.md. Secrets: never commit real values. Use a key scoped to
# this one bucket.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional automatic cloud backup: "daily" (03:00 server time) or a cron
# expression such as "0 */6 * * *". Ignored unless S3_* is configured.
BACKUP_SCHEDULE=

# Seed only (`npx prisma db seed`): the super admin's password. Required when
# NODE_ENV=production; locally it defaults to Study-Plan-2026!. Must meet the
# password rules (12+ chars, upper, lower, number, symbol, not containing
# "admin").
SEED_ADMIN_PASSWORD=
