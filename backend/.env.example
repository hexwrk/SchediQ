DATABASE_URL="postgresql://user:password@localhost:5432/schediq"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
OPENAI_API_KEY=""
# AI_PARSER selects the parse path: "rule" (default, no network) or "openai".
AI_PARSER=rule
# System backup (admin System page). "auto" tries pg_dump then falls back to a
# JSON export; "json" forces the JSON export. Override binary paths if pg_dump /
# psql are not on PATH. Their major version must match the server (postgres:16).
BACKUP_MODE=auto
PG_DUMP_PATH=
PSQL_PATH=
# Password reset. APP_URL is the frontend origin used to build reset links.
# RESET_DEMO_MODE=true returns the reset link in the API response (no email
# service in the demo); defaults to true unless NODE_ENV=production.
APP_URL="http://localhost:3000"
RESET_DEMO_MODE=true
